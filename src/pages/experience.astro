---
import Layout from "../layouts/Layout.astro";
---

<Layout uid="Experience">
    <div class="h-full overflow-y-auto scrollbar-hidden scroll-fade">
        <div class="flex justify-center items-center min-h-full px-(--gutter) py-24">
            <div
                class="flex flex-col gap-y-4 w-full md:w-2/3 p-6 md:p-8 bg-neutral-50 rounded-md shadow-lg card-hover hero-image"
            >
                <div class="flex flex-col gap-y-1">
                    <h1 class="font-serif font-semibold text-2xl text-neutral-900">
                        Software Developer Intern @ <span class="text-emerald-700"
                            >Ambani Media</span
                        >
                    </h1>
                    <h3
                        class="text-sm font-medium tracking-wide text-gray-400 uppercase"
                    >
                        March 2025 &ndash; March 2026
                    </h3>
                </div>
                <div class="flex flex-col gap-y-3 text-gray-700 leading-relaxed">
                    <p>
                        Built a Hisense VIDAA TV app using TypeScript, React, and
                        Next.js and integrated it with existing APIs, allowing users
                        to access their mobile content on a TV screen using QR code
                        login
                    </p>
                    <p>
                        Designed and implemented a certificate generation feature
                        using pdf-lib, dynamically creating personalized PDFs from
                        user data and integrating it into existing workflows.
                    </p>
                    <p>
                        Updated and migrated legacy assets in MongoDB to reference
                        Amazon S3 URLs, resulting in improved reliability and
                        scalability
                    </p>
                    <p>
                        Automated and optimized bulk upload workflows with custom
                        scripts, reducing turnaround times significantly
                    </p>
                    <p>Worked on OTP authentication screen for a mobile app</p>
                </div>
            </div>
        </div>
    </div>
</Layout>
