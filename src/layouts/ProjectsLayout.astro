---
import "../styles/global.css";
import Layout from "./Layout.astro";
import Arrow from "../assets/arrow.svg";

const { uid } = Astro.props;
---

<Layout uid={uid}>
    <div class="h-full overflow-y-auto scrollbar-hidden scroll-fade">
        <div class="flex flex-col gap-y-6 w-full md:w-2/3 mx-auto px-(--gutter) md:px-0 pt-24 md:pt-28 pb-24 md:pb-28">
            <a
                href="/projects"
                class="group flex flex-row items-center gap-x-2 self-start text-sm text-gray-500 transition-colors duration-300 hover:text-neutral-900"
            >
                <Arrow
                    class="size-4 transition-transform duration-300 ease-in-out group-hover:-translate-x-1"
                />
                Back to Projects
            </a>
            <slot />
        </div>
    </div>
</Layout>
