{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "compatibility_date": "2026-11-10",
    "compatibility_flags": ["global_fetch_strictly_public"],
    "name": "personal-website",
    "assets": {
        "directory": "./dist",
        "not_found_handling": "404-page",
    },
    "observability": {
        "enabled": true,
    },
}
